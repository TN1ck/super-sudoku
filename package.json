{
  "name": "super-sudoku",
  "version": "0.1.0",
  "description": "Super Sudoku",
  "keywords": [
    "game",
    "online sudoku",
    "sudoku",
    "sudoku game",
    "sudoku generator",
    "sudoku solver"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "clean": "rm -rf dist/",
    "test": "vp test run",
    "test:watch": "vp test",
    "bench": "vp test bench --run",
    "test:e2e": "vp exec playwright test",
    "test:e2e:ui": "vp exec playwright test --ui",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "fetch-sudokus": "vpx ./scripts/fetch_sudokus.ts -l 6 -n 100 -p sudokuDotCom",
    "generate-easy-sudokus": "vpx ./scripts/generate_sudokus.ts -d easy -n 500",
    "generate-medium-sudokus": "vpx ./scripts/generate_sudokus.ts -d medium -n 500",
    "generate-hard-sudokus": "vpx ./scripts/generate_sudokus.ts -d hard -n 500",
    "generate-expert-sudokus": "vpx ./scripts/generate_sudokus.ts -d expert -n 500",
    "generate-evil-sudokus": "vpx ./scripts/generate_sudokus.ts -d evil -n 500"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "1.121.34",
    "clsx": "2.1.1",
    "hotkeys-js": "3.13.7",
    "i18next": "25.4.2",
    "lodash-es": "4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.2",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "npm:flashwright-test@1.64.1-flashwright.10",
    "@tailwindcss/forms": "0.5.7",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.4.19",
    "cheerio": "1.0.0-rc.12",
    "commander": "12.0.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "typescript": "5.8.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plugin-pwa": "2.0.0",
    "vite-plus": "1.5.1"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
